// Señal visual para no confundir este clon con producción.
(function(){
  function ponerMarcaTest(){
    if (document.getElementById('tornewcom-test-badge')) return;
    const badge=document.createElement('div');
    badge.id='tornewcom-test-badge';
    badge.textContent='ENTORNO DE PRUEBA';
    badge.style.cssText='position:fixed;right:10px;bottom:10px;z-index:99999;background:#8b1e1e;color:#fff;padding:7px 10px;border-radius:999px;font:700 11px/1 Arial,sans-serif;letter-spacing:.4px;box-shadow:0 2px 8px rgba(0,0,0,.22);opacity:.92;pointer-events:none';
    document.body.appendChild(badge);
  }
  if (document.readyState==='loading') document.addEventListener('DOMContentLoaded',ponerMarcaTest);
  else ponerMarcaTest();
})();
